# Copy to .env for local development. Set these in Vercel → Project → Settings → Environment Variables.

# Local SQLite (dev only). On Vercel you need a hosted Postgres URL instead —
# SQLite / better-sqlite3 is not suitable for Vercel serverless.
DATABASE_URL="file:./prisma/dev.db"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required behind proxies (Vercel). Keep true in production.
AUTH_TRUST_HOST="true"
