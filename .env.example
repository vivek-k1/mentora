# Copy to .env for local development. Set these in Vercel → Project → Settings → Environment Variables.

# PostgreSQL connection string (Neon, Vercel Postgres, Prisma Postgres, etc.)
# Prefer the pooled URL for serverless (often includes ?pgbouncer=true or a -pooler host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Required behind proxies (Vercel). Keep true in production.
AUTH_TRUST_HOST="true"
